<Window x:Class="KatanHra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatanHra"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="390">
    <Grid Margin="0,0,0,-6" Background="#FFF3F4F6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lblScore" Content="Body: 0 / 50" HorizontalAlignment="Left" Height="44" Margin="31,10,0,0" VerticalAlignment="Top" Width="201" FontWeight="Bold" FontSize="20" Background="#FF88A5E3" Foreground="#FF111827"/>
        <Label x:Name="lblPacks" Content="Otvorených balíčkov: 0" HorizontalAlignment="Left" Margin="27,54,0,0" VerticalAlignment="Top" Height="26" Width="209"/>
        <TextBlock x:Name="lblMessage" HorizontalAlignment="Left" Height="26" Margin="31,82,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="328" Foreground="#FF1F2937" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock x:Name="lblCard" HorizontalAlignment="Center" Height="235" Margin="0,113,0,0" Padding="8" TextWrapping="Wrap" VerticalAlignment="Top" Width="328" Background="White" Foreground="#FF1F2937" FontSize="15"/>
        <Button x:Name="btnOpen" Content="Otvor balíček" HorizontalAlignment="Left" Margin="31,361,0,0" VerticalAlignment="Top" Height="43" Width="90" FontSize="14" Background="#FF88A5E3" Foreground="#FF111827" Click="btnOpen_Click"/>
        <Button x:Name="btnRestart" Content="Nová hra " HorizontalAlignment="Center" Margin="0,362,0,0" VerticalAlignment="Top" Width="90" Height="42" FontSize="14" Background="#FF88A5E3" Foreground="#FF111827" Click="btnRestart_Click"/>
    </Grid>
</Window>